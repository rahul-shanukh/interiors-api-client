{
  "name": "interiors-api-client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@apollo/server": "5.5.0",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.1026.0",
    "@aws-sdk/s3-request-presigner": "3.1026.0",
    "@google-cloud/storage": "7.19.0",
    "@google-cloud/tasks": "6.2.0",
    "@nestjs/apollo": "13.2.4",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.18",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.2.4",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.215.0",
    "@opentelemetry/sdk-node": "0.215.0",
    "@upstash/redis": "^1.38.0",
    "@willsoto/nestjs-prometheus": "6.1.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "connect-redis": "6.1.3",
    "dataloader": "2.2.3",
    "express": "^5.2.1",
    "express-session": "1.19.0",
    "fireball": "workspace:*",
    "firebase-admin": "^14.2.0",
    "graphql": "16.13.2",
    "handlebars": "4.7.9",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "mongoose": "8.23.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "8.0.7",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "resend": "6.17.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "11.0.18",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.18",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/express-session": "1.18.2",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.17",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.4",
    "jest": "30.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@nestjs/core",
      "@scarf/scarf",
      "bcrypt",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
