{{! backend\src\infrastructure\notifications\templates\email\quote-estimate.hbs }}

<html>
  <head>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
        color: #333;
      }
      .container {
        width: 80%;
        margin: 20px auto;
        border: 1px solid #eee;
        padding: 20px;
        border-radius: 10px;
      }
      .header {
        border-bottom: 2px solid #007bff;
        padding-bottom: 10px;
        margin-bottom: 20px;
      }
      .price {
        font-size: 24px;
        color: #28a745;
        font-weight: bold;
      }
      .footer {
        margin-top: 30px;
        font-size: 12px;
        color: #777;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>JC Interiors</h1>
      </div>
      <p>Hi {{name}},</p>
      <p>Thank you for reaching out to us for your interior design project.
        Based on your selection, here is your estimate:</p>

      <ul>
        <li><strong>Property Type:</strong> {{bhkType}}</li>
        <li><strong>Interior Package:</strong> {{package}}</li>
      </ul>

      <p>Your total estimated price is:</p>
      <p class='price'>₹{{estimatedPrice}}</p>

      <p>Our team will contact you shortly to discuss the design for your plot.
        We're excited to help you build your dream space!</p>

      <div class='footer'>
        <p>This is an automated estimate generated by JC Interiors. Prices are
          subject to change after site inspection.</p>
      </div>
    </div>
  </body>
</html>