{
  "title": "Quotes Module Health",
  "tags": ["nestjs", "quotes"],
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Total HTTP Requests by Route",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, route, status)",
          "legendFormat": "{{method}} {{route}} - {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Quotes Generated",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "quotes_created_total",
          "legendFormat": "{{status}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    }
  ],
  "schemaVersion": 36
}
